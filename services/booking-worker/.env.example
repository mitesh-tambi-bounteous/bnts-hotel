# Database (use a role limited to email_outbox: SELECT, UPDATE; no DELETE)
DB_URL=jdbc:postgresql://localhost:5432/hotel
DB_USER=hotel
SPRING_DATASOURCE_PASSWORD=

# Amazon SES (region ap-south-1). Blank = log emails instead of sending locally.
# Required in qa and prod: the worker refuses to start without it.
# The address/domain must be a verified SES identity; the account must be out of the SES sandbox.
SES_FROM_ADDRESS=
# AWS credentials come from the default provider chain (IAM role in qa/prod).
