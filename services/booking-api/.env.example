# JDBC URL, e.g. jdbc:postgresql://localhost:5432/booking
SPRING_DATASOURCE_URL=
SPRING_DATASOURCE_USERNAME=
SPRING_DATASOURCE_PASSWORD=
# Razorpay test or live keys. The API refuses to start when these are blank, unless the local
# profile (or PAYMENTS_IN_MEMORY=true) opts in to the fake gateway. Never honoured in qa and prod.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
