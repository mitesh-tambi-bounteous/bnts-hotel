# JDBC URL, e.g. jdbc:postgresql://localhost:5432/booking
SPRING_DATASOURCE_URL=
SPRING_DATASOURCE_USERNAME=
SPRING_DATASOURCE_PASSWORD=
# Razorpay test or live keys. Leave blank locally to use the in-memory payment gateway (logs a WARN).
# The qa and prod profiles refuse to start when these are blank.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
