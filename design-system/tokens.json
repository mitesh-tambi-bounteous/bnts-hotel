{
  "color-fg": {"$type": "color", "$value": {"colorSpace": "srgb", "components": [0.0588, 0.0902, 0.1647], "hex": "#0f172a"}, "$description": "Default text; matches slate-900 body text in layout.tsx"},
  "color-bg": {"$type": "color", "$value": {"colorSpace": "srgb", "components": [1, 1, 1], "hex": "#ffffff"}, "$description": "Page background; matches bg-white in layout.tsx"},
  "color-fg-muted": {"$type": "color", "$value": {"colorSpace": "srgb", "components": [0.2784, 0.3333, 0.4118], "hex": "#475569"}, "$description": "Secondary text and hints"},
  "color-bg-subtle": {"$type": "color", "$value": {"colorSpace": "srgb", "components": [0.9451, 0.9608, 0.9765], "hex": "#f1f5f9"}, "$description": "Subtle surfaces, skeletons, hover"},
  "color-primary": {"$type": "color", "$value": {"colorSpace": "srgb", "components": [0.1451, 0.3882, 0.9216], "hex": "#2563eb"}, "$description": "Primary actions, focus ring, selected state"},
  "color-primary-hover": {"$type": "color", "$value": {"colorSpace": "srgb", "components": [0.1137, 0.3059, 0.8471], "hex": "#1d4ed8"}, "$description": "Primary hover"},
  "color-primary-fg": {"$type": "color", "$value": {"colorSpace": "srgb", "components": [1, 1, 1], "hex": "#ffffff"}, "$description": "Text on primary or danger fills"},
  "color-border": {"$type": "color", "$value": {"colorSpace": "srgb", "components": [0.7961, 0.8353, 0.8824], "hex": "#cbd5e1"}, "$description": "Default borders and dividers"},
  "color-border-strong": {"$type": "color", "$value": {"colorSpace": "srgb", "components": [0.3922, 0.4549, 0.5451], "hex": "#64748b"}, "$description": "Form control borders"},
  "color-danger": {"$type": "color", "$value": {"colorSpace": "srgb", "components": [0.7255, 0.1098, 0.1098], "hex": "#b91c1c"}, "$description": "Destructive actions and errors"},
  "color-danger-bg": {"$type": "color", "$value": {"colorSpace": "srgb", "components": [0.9961, 0.949, 0.949], "hex": "#fef2f2"}, "$description": "Danger tint"},
  "color-success": {"$type": "color", "$value": {"colorSpace": "srgb", "components": [0.0824, 0.502, 0.2392], "hex": "#15803d"}, "$description": "Success"},
  "color-success-bg": {"$type": "color", "$value": {"colorSpace": "srgb", "components": [0.9412, 0.9922, 0.9569], "hex": "#f0fdf4"}, "$description": "Success tint"},
  "color-warning": {"$type": "color", "$value": {"colorSpace": "srgb", "components": [0.5725, 0.251, 0.0549], "hex": "#92400e"}, "$description": "Warning"},
  "color-warning-bg": {"$type": "color", "$value": {"colorSpace": "srgb", "components": [1, 0.9843, 0.9216], "hex": "#fffbeb"}, "$description": "Warning tint"},
  "color-info": {"$type": "color", "$value": {"colorSpace": "srgb", "components": [0.1137, 0.3059, 0.8471], "hex": "#1d4ed8"}, "$description": "Info"},
  "color-info-bg": {"$type": "color", "$value": {"colorSpace": "srgb", "components": [0.9373, 0.9647, 1], "hex": "#eff6ff"}, "$description": "Info tint"},

  "space-1": {"$type": "dimension", "$value": {"value": 4, "unit": "px"}, "$description": "Spacing step 1"},
  "space-2": {"$type": "dimension", "$value": {"value": 8, "unit": "px"}, "$description": "Spacing step 2"},
  "space-3": {"$type": "dimension", "$value": {"value": 16, "unit": "px"}, "$description": "Spacing step 3"},
  "space-4": {"$type": "dimension", "$value": {"value": 24, "unit": "px"}, "$description": "Spacing step 4"},
  "space-5": {"$type": "dimension", "$value": {"value": 32, "unit": "px"}, "$description": "Spacing step 5"},
  "space-6": {"$type": "dimension", "$value": {"value": 48, "unit": "px"}, "$description": "Spacing step 6"},

  "radius-sm": {"$type": "dimension", "$value": {"value": 4, "unit": "px"}, "$description": "Small radius"},
  "radius-md": {"$type": "dimension", "$value": {"value": 8, "unit": "px"}, "$description": "Medium radius"},
  "radius-lg": {"$type": "dimension", "$value": {"value": 16, "unit": "px"}, "$description": "Large radius"},
  "radius-full": {"$type": "dimension", "$value": {"value": 9999, "unit": "px"}, "$description": "Pill / circle"},

  "font-size-sm": {"$type": "dimension", "$value": {"value": 0.875, "unit": "rem"}, "$description": "Small text"},
  "font-size-md": {"$type": "dimension", "$value": {"value": 1, "unit": "rem"}, "$description": "Body text"},
  "font-size-lg": {"$type": "dimension", "$value": {"value": 1.25, "unit": "rem"}, "$description": "Large text / headings"},
  "font-size-xl": {"$type": "dimension", "$value": {"value": 1.75, "unit": "rem"}, "$description": "Page title"},

  "size-control": {"$type": "dimension", "$value": {"value": 2.5, "unit": "rem"}, "$description": "Control height"},
  "size-control-sm": {"$type": "dimension", "$value": {"value": 2, "unit": "rem"}, "$description": "Small control height"},
  "size-control-lg": {"$type": "dimension", "$value": {"value": 3, "unit": "rem"}, "$description": "Large control height"},
  "size-icon": {"$type": "dimension", "$value": {"value": 1.25, "unit": "rem"}, "$description": "Checkbox / radio size"},
  "size-avatar": {"$type": "dimension", "$value": {"value": 2.5, "unit": "rem"}, "$description": "Avatar size"},
  "size-drawer": {"$type": "dimension", "$value": {"value": 360, "unit": "px"}, "$description": "Drawer width"},
  "size-modal": {"$type": "dimension", "$value": {"value": 480, "unit": "px"}, "$description": "Modal max width"},
  "size-menu": {"$type": "dimension", "$value": {"value": 200, "unit": "px"}, "$description": "Menu min width"},
  "size-tooltip": {"$type": "dimension", "$value": {"value": 240, "unit": "px"}, "$description": "Tooltip max width"},
  "size-content": {"$type": "dimension", "$value": {"value": 672, "unit": "px"}, "$description": "Content max width (max-w-2xl in guest-web page.tsx)"},
  "size-grid-min": {"$type": "dimension", "$value": {"value": 200, "unit": "px"}, "$description": "Grid column min width"},
  "border-width": {"$type": "dimension", "$value": {"value": 1, "unit": "px"}, "$description": "Hairline border"},
  "border-width-strong": {"$type": "dimension", "$value": {"value": 2, "unit": "px"}, "$description": "Focus / selected border"},

  "font-sans": {"$type": "fontFamily", "$value": ["ui-sans-serif", "system-ui", "sans-serif"], "$description": "Base font"},
  "font-weight-normal": {"$type": "fontWeight", "$value": 400},
  "font-weight-medium": {"$type": "fontWeight", "$value": 500},
  "font-weight-bold": {"$type": "fontWeight", "$value": 700},
  "line-height-base": {"$type": "number", "$value": 1.5},
  "opacity-overlay": {"$type": "number", "$value": 0.5, "$description": "Backdrop opacity"},
  "opacity-disabled": {"$type": "number", "$value": 0.5, "$description": "Disabled opacity"},
  "z-popup": {"$type": "number", "$value": 50},
  "z-overlay": {"$type": "number", "$value": 100},

  "button-primary-background": {"$type": "color", "$value": "{color-primary}"},
  "button-primary-foreground": {"$type": "color", "$value": "{color-primary-fg}"},
  "button-primary-border": {"$type": "color", "$value": "{color-primary}"},
  "button-primary-hover": {"$type": "color", "$value": "{color-primary-hover}"},
  "button-secondary-background": {"$type": "color", "$value": "{color-bg}"},
  "button-secondary-foreground": {"$type": "color", "$value": "{color-fg}"},
  "button-secondary-border": {"$type": "color", "$value": "{color-border-strong}"},
  "button-danger-background": {"$type": "color", "$value": "{color-danger}"},
  "button-danger-foreground": {"$type": "color", "$value": "{color-primary-fg}"},
  "button-danger-border": {"$type": "color", "$value": "{color-danger}"},
  "button-default-radius": {"$type": "dimension", "$value": "{radius-md}"},
  "button-default-padding": {"$type": "dimension", "$value": "{space-3}"},
  "card-default-background": {"$type": "color", "$value": "{color-bg}"},
  "card-default-foreground": {"$type": "color", "$value": "{color-fg}"},
  "card-default-border": {"$type": "color", "$value": "{color-border}"},
  "card-default-radius": {"$type": "dimension", "$value": "{radius-lg}"},
  "card-default-padding": {"$type": "dimension", "$value": "{space-4}"}
}
